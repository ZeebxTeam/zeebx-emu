# The core's business card: this is where RetroArch gets the name in the list, the link to the
# No-Intro database and what it tells the user the core can do.
#
# **The capability fields have to match what the ABI does.** A `savestate = "false"` on a core
# that serializes hides the feature in the interface; a `hw_render = "true"` on a core that asks
# for no context makes RetroArch prepare a graphics card for nothing. Each line below was checked
# against `src/lib.rs`, and the comment says where.
#
# The shape is that of the `libretro-super` files (checked against the installed
# `desmume_libretro.info`): three blocks, and the description last.

# Software Information
display_name = "Zeebx"
authors = "ZeebxTeam"
# The same as the `valid_extensions` of `retro_get_system_info`.
supported_extensions = "mod|zip|7z"
corename = "Zeebx"
# **`license`, singular.** `licenses` isn't read by anyone, and it was what was here.
# GPLv3, and not GPLv2+: the core links crates that are Apache-2.0 only (`ab_glyph`,
# `sevenz-rust2`, `zopfli`), and the binary can only be distributed under the GPLv3. The code is
# still GPLv2+.
license = "GPLv3"
permissions = ""
# Follows the crate version. See the `version` in the root `Cargo.toml`.
display_version = "0.5.1"
categories = "Emulator"

# Hardware Information
manufacturer = "TecToy"
systemname = "Zeebo"
systemid = "zeebo"

# Libretro Features
# No-Intro database used for naming and for finding the covers. See `tools/catalog.py`.
database = "Mobile - Zeebo"
supports_no_game = "false"
# `retro_serialize_size`, `retro_serialize` and `retro_unserialize` deliver the whole state.
savestate = "true"
savestate_features = "serialized"
# `retro_cheat_set` is an empty body: the console has no cheats and the core doesn't make one up.
cheats = "false"
# The core calls `SET_INPUT_DESCRIPTORS`: the buttons show up named in the controls menu.
input_descriptors = "true"
# `retro_get_memory_data` returns null: BREW saves are files, not a contiguous region.
memory_descriptors = "false"
# Saves go to the folder `GET_SAVE_DIRECTORY` points to, and not next to the game.
libretro_saves = "true"
# The core registers Core Options V2 and a SET_VARIABLES fallback. See `src/lib.rs`.
core_options = "true"
load_subsystem = "false"
# The core asks for a context through `SET_HW_RENDER` and draws into the frontend's framebuffer.
# **When it can't, it falls back to the software rasterizer** -- the line below is what drawing on
# the graphics card requires, not what the core requires to run.
hw_render = "true"
required_hw_api = "OpenGL Core >= 3.3 | OpenGL ES >= 3.2"
# Both come from `retro_get_system_info`: the game is opened by path, and the `.zip` belongs to
# the console, not the frontend -- BREW is what opens it.
needs_fullpath = "true"
block_extract = "true"
disk_control = "false"
is_experimental = "false"

# BIOS/Firmware
# None: the device BIOS isn't needed, the engine implements BREW.
firmware_count = 0

# The "Core notes" lines of the information page. **The format has no address field** --
# checked across the 582 `.info` files of a RetroArch install: no URL field, and the 34 that
# carry a link put it here, in the `(!) Homepage: ...` pattern. The `|` separates one line from
# the next.
#
# The content is the same as the desktop's "About" and Android's settings -- repository and
# Discord --, plus what only the RetroArch user needs to know, because the core has no screen to
# say it.
notes = "(!) Repository: https://github.com/ZeebxTeam/zeebx-emu|(!) Discord: https://discord.gg/D96HjsKTPa|(!) The Z-Wheel lists the games in the same folder as the one you opened; on its own, the console menu opens empty|(!) MIDI with a sample bank: put an .sf2 in soundfonts/, in the frontend's system folder; the core writes the exact path to the log when the game opens|(!) Without an OpenGL context the core draws on the processor: nothing stops working, it just gets slower|(!) On the PlayStation Vita drawing stays on the processor: the RetroArch there doesn't provide OpenGL ES 3|(!) The image is 4:3 and the frontend is what enlarges it: with Integer Scale on it only comes out in multiples of 640x480, and on a 1080p screen that is 1280x960 with bars. Turn Integer Scale off to fill the screen; no core setting changes that size"

description = "The definitive Zeebo emulator! Powered by Qualcomm BREW 4.0.2, it loads the game as .mod, .zip or .7z, draws on the processor or the graphics card, and brings the Z-Wheel -- the device menu -- when the games folder is mounted."
