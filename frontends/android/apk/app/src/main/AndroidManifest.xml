<?xml version="1.0" encoding="utf-8"?>
<!-- The app has no class of its own: the activity is the system's NativeActivity, and what
     it loads is `libzeebx_android.so`, through `android.app.lib_name`. Hence hasCode="false". -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- A ROM collection lives outside the app's directory, and since Android 11 reading it
         requires "all files access". It isn't granted at install time: the user grants it in
         Settings › Apps › Zeebx. Without it Zeebx only sees its own folder. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- `appCategory="game"` isn't storefront decoration: it is what **keeps the orientation
         lock in force**. Starting with Android 16, on target 36 or higher, the system starts
         ignoring `screenOrientation`, `resizeableActivity` and aspect ratios on screens whose
         smallest side is 600dp or more — tablet, foldable, desktop —, and Android 17 even
         removes the option to opt out. Games are the exception that remains, and a console
         emulator is a game. Today the target is 35 and none of this reaches us; when it goes up,
         this line is what keeps the screen from rotating on its own in the middle of a race. -->
    <application
        android:label="Zeebx"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:appCategory="game"
        android:hasCode="false">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode">
            <meta-data
                android:name="android.app.lib_name"
                android:value="zeebx_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
